{
  "_readme": [
    "机检规则文件。qc_audit.py 默认读取脚本同级本文件；缺失则退回内置默认值（零配置可跑）。",
    "换书复用：只改本文件即可，不必改脚本。",
    "  - banned_words   通用硬禁：当代科技术语、后世才有人物与事物（跨题材通用）",
    "  - lexicon_map    本项目方言：史实/设定限定用词，左=禁用写法，右=应替换为",
    "  - name_typo      本项目人名错写",
    "  - formula/formula2  套话词表（作者文风病史沉淀，换书写法后按需重标）",
    "  - style_band     文风密度参考带，只出观测与偏离排行，不判未过"
  ],
  "version": 6,

  "words": {
    "min": 2600,
    "standard_max": 3200,
    "hard_max": 3520,
    "_note": "标准区间 2600-3200；超出 standard_max 但未超 hard_max（上浮 10%）只告警；超 hard_max 判未过。本文件即口径来源，换书只改这里"
  },
  "title_words": 7,

  "banned_words": [
    "GDP", "KPI", "系统", "互联网", "蒸汽机", "供应链", "杠杆",
    "鉴真", "郑和", "贾岛", "近代火炮"
  ],
  "lexicon_map": {
    "太极宫": "大兴宫",
    "太极殿": "大兴殿"
  },
  "modern_hard": [
    "奶酪", "蛋糕", "起跑线", "钢印", "公司", "董事长",
    "签字权", "付款权", "绩效", "第二选项", "管理层", "复盘", "闭环",
    "政策红利", "全员通告", "新老板", "总裁", "业绩", "风险点"
  ],
  "modern_warn": [
    "底线", "赋能", "赛道", "颗粒度",
    "底层逻辑", "考核", "指标", "认知", "信息差", "用户", "产品"
  ],
  "name_typo": ["杨谦", "杨先"],

  "formula": {
    "原以为": 1, "没想到": 1, "愣了一下": 1, "说不出话": 1,
    "他知道": 1, "他也知道": 1, "他明白": 1, "他清楚": 1,
    "叹了口气": 1, "深吸一口气": 1, "眉头一皱": 1, "心里一沉": 1,
    "因为他是杨广": 0, "大隋的皇帝": 1, "一件一件": 1,
    "不能马虎": 0, "不敢马虎": 0, "这是他的使命": 0, "也是他的宿命": 0,
    "越来越好": 1, "不急": 1, "但不停": 0, "一步一步": 1
  },
  "formula_core": ["他知道", "他也知道", "原以为", "没想到", "愣了一下", "说不出话"],
  "formula_core_cap": 3,

  "formula2": {
    "静场": [["静了一息", "静了一静", "沉默了一息", "沉默片刻"], 1],
    "停顿": [["顿了顿", "停了一停"], 1],
    "半晌": [["半晌"], 1],
    "看一眼": [["看了他一眼", "看了她一眼", "看了他们一眼", "看了一眼"], 1],
    "轻笑": [["笑了一下", "笑了一声", "笑了笑"], 2],
    "指节指尖": [["指节", "指尖"], 2],
    "喉头": [["喉头", "喉咙"], 1],
    "没说话": [["没说话", "没接话", "没有接话", "没有出声", "没出声"], 1]
  },
  "not_a_b": {
    "pattern": "不是[^。！？；]{1,20}[，。]是",
    "cap": 3
  },

  "style_band": {
    "sent_avg": [18.5, 25.0],
    "dialogue_avg": [16.5, 30.0],
    "narr_avg": [18.0, 26.0],
    "short_sent": [0.15, 0.34],
    "para_avg": [18.0, 25.0],
    "dialogue": [0.05, 0.48]
  },
  "style_top_n": 10,

  "end_marks": [
    "因为他是杨广", "大隋的皇帝", "这是他的使命", "也是他的宿命",
    "不能马虎", "不敢马虎", "一件一件", "一步一步", "但不停",
    "他要让这个天下", "这就是他要做的事"
  ],

  "exclude_pattern": "(README|说明|样章)"
}
